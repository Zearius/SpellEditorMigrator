<Window x:Class="SpellMigration.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/worldserver.ico"
        Title="AzerothCore Spell Migration Tool" Height="640" Width="820"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings..." Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Spell ID input -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Spell ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Name="SpellIdBox" Width="120" VerticalContentAlignment="Center"/>
                <Button Content="Fetch &amp; Validate" Margin="8,0,0,0" Padding="10,4"
                        Click="FetchAndValidate_Click"/>
                <Button Content="Clear" Margin="8,0,0,0" Padding="10,4" Click="Clear_Click"/>
                <TextBlock Name="SpellNameText" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontWeight="Bold"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Validation results:" FontWeight="Bold" Margin="0,4,0,4"/>

            <!-- Validation issues -->
            <ListBox Grid.Row="2" Name="IssuesList" Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- SQL preview -->
            <GroupBox Grid.Row="3" Header="Generated spell_dbc INSERT (preview only, not yet applied)">
                <TextBox Name="SqlPreviewBox" IsReadOnly="True" TextWrapping="NoWrap"
                          AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          FontFamily="Consolas" FontSize="12" Background="#FFF5F5F5"/>
            </GroupBox>

            <!-- Actions / status -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Name="ApplyButton" Content="Apply to AzerothCore" Padding="14,6"
                        IsEnabled="False" Click="Apply_Click"/>
                <TextBlock Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
